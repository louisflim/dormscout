# Copy to application-local.properties (same folder). That file is gitignored.
#
#   PowerShell (from backend folder):
#   copy src\main\resources\application-local.properties.example src\main\resources\application-local.properties
#
# Use either format below — both work with application.properties placeholders.

MYSQL_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD_HERE
GROQ_API_KEY=gsk_yourGroqKeyHere

# Or set Spring properties directly:
# spring.datasource.password=YOUR_MYSQL_ROOT_PASSWORD_HERE
# groq.api.key=gsk_yourGroqKeyHere

# Uncomment if your MySQL user is not root:
# spring.datasource.username=myuser
